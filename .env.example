# Copy this file to .env and fill in real values for local testing.
# .env is gitignored — never commit real secrets. On Railway, set these as
# project Variables instead (Railway doesn't read .env files).

# Required to actually send sign-in emails. Get one from https://sendgrid.com
# (Settings -> API Keys -> Create API Key). Without this, sign-in links are only
# printed to the server console, which is fine for local testing.
SENDGRID_API_KEY=

# Comma-separated list of email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=dataart.com

# The sender address, shown on the sign-in email. Must be exactly the address you
# verified in SendGrid under Settings -> Sender Authentication -> Single Sender
# Verification (no DNS access needed — just confirm a link sent to that inbox).
FROM_EMAIL=Every Day Is Like Sunday <you@dataart.com>

# The site's public URL, used to build the link emailed to people.
# Leave unset for local dev (falls back to http://localhost:3000).
APP_BASE_URL=http://localhost:3000

# Uncomment to change the port or where data (events/sessions/profiles) is stored.
# PORT=3000
# DATA_DIR=./data
